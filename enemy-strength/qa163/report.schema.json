{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ES28 actual module layout measurement",
  "type": "object",
  "required": ["schemaVersion", "mode", "candidate", "nativeGameplay", "viewport", "sourceCatalog", "open"],
  "properties": {
    "schemaVersion": {"const": 1},
    "nativeGameplay": {"const": false},
    "mode": {"enum": ["battle", "cards", "skills"]},
    "candidate": {"type": "boolean"},
    "open": {"type": "boolean"},
    "viewport": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "number"}, "height": {"type": "number"}}},
    "sourceCatalog": {"type": "object", "required": ["folders", "gokuMoves"], "properties": {"folders": {"const": 16}, "gokuMoves": {"const": 11}}},
    "controls": {"type": "array", "items": {"type": "object", "required": ["label", "rect", "fontSize", "fullyVisible"]}},
    "scrollRegions": {"type": "array", "items": {"type": "object", "required": ["selector", "clientHeight", "scrollHeight", "clientWidth", "scrollWidth"]}},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}}
  }
}
